<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style2.css">
</head>

<body>

    <body>
        <video autoplay muted loop id="bg-video">
            <source src="background.mp4" type="video/mp4">
            Your browser does not support HTML5 video.
        </video>
        <div class="container">
            <div class="headings">
                <h2>Your</h2>
                <h2 class="theme">Appointmets</h2>
            </div>
            <div class="appoint">
                <% if(data)for(let i=0;i<data.length;i++){if(data[i].status=="WAITING" && call==0){ %>
                    <div class="box">
                        <div class="cell">
                            <div class="dis">
                                <h3>
                                    <%= data[i].discription %>
                                </h3>
                            </div>
                            <div class="query">
                                <form action="/promote" method="post">
                                    <input type="hidden" value="<%= id %>" name="pid">
                                    <input type="hidden" value="<%= data[i].id %>" name="id">
                                    <button class="status" type="submit">
                                        <%= data[i].status%>
                                    </button>
                                </form>
                                <p class="id">
                                    Ptient id : <%= data[i].patient_id %>
                                </p>
                            </div>
                        </div>
                    </div>
                    <% }else if(data[i].status=="PENDING" && call==1) {%>
                        <div class="box">
                            <div class="cell">
                                <div class="dis">
                                    <h3>
                                        <%= data[i].discription %>
                                    </h3>
                                </div>
                                <div class="query">
                                    <form action="/promote" method="post">
                                        <input type="hidden" value="<%= id %>" name="pid">
                                        <input type="hidden" value="<%= data[i].id %>" name="id">
                                        <button class="status" type="submit">
                                            <%= data[i].status%>
                                        </button>
                                    </form>
                                    <p class="id">
                                        Ptient id : <%= data[i].patient_id %>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <% }} %>
            </div>
        </div>
        </div>
    </body>

</html>