<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <video autoplay muted loop id="bg-video">
        <source src="backgroung.mp4" type="video/mp4">
        Your browser does not support HTML5 video.
    </video>
    <div class="container">
        <div class="headings">
            <h2>Your All </h2>
            <h2 class="theme">Appointmets</h2>
        </div>
        <div class="appoint">
            <div class="box">
                <div class="cell">
                    <div class="dis">
                        <h3>Click on </h3>
                        <h3 class="theme">add</h3>
                        <h3> for Create new Appointmet
                        </h3>
                    </div>
                    <div class="query">
                        <form action="/new_apoint" method="post">
                            <input type="hidden" value="<%= id %>" name="id">
                            <button class="button" type="submit">ADD</button>
                        </form>
                    </div>
                </div>
            </div>
            <% if(data)for(let i=0;i<data.length;i++){if(data[i].status=="WAITING" ||data[i].status=="PENDING" ){let cls; if(data[i].status=="WAITING"){cls="red"}else{cls="green"} %>
                <div class="box">
                    <div class="cell">
                        <div class="dis">
                            <h3>
                                <%= data[i].discription %>
                            </h3>
                        </div>
                        <div class="query">
                            <p class="status <%= cls %>">
                                Status : <%= data[i].status %>
                            </p>
                            <p class="id">
                                Dr id : <%= data[i].doctor_id %>
                            </p>
                        </div>
                    </div>
                </div>
                <% } }%>
        </div>
    </div>
</body>

</html>